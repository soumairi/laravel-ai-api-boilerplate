APP_NAME="Laravel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
API_VERSION=1.0.0
APP_PORT=8080
BUILD_TARGET=development
APP_UID=1000
APP_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
HASH_VERIFY=true
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
POSTGRES_PORT=54320
TEST_DB_DATABASE=laravel_testing

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_FORWARD=63790

JWT_ALGO=RS256
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=laravel-api
JWT_PUBLIC_KEY=file://storage/keys/jwt-public.pem
JWT_PRIVATE_KEY=file://storage/keys/jwt-private.pem
JWT_PASSPHRASE=
JWT_TTL=15
JWT_BLACKLIST_ENABLED=true

REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
REFRESH_TOKEN_TTL=43200
API_MAX_REQUEST_BYTES=1048576
API_RATE_LIMIT_AUTH_PER_MINUTE=10
API_RATE_LIMIT_LOGIN_IDENTITY_PER_MINUTE=5
API_RATE_LIMIT_REGISTER_PER_MINUTE=3
API_RATE_LIMIT_FORGOT_PASSWORD_ATTEMPTS=3
API_RATE_LIMIT_FORGOT_PASSWORD_DECAY_MINUTES=15
API_RATE_LIMIT_REFRESH_PER_MINUTE=10
API_RATE_LIMIT_PUBLIC_PER_MINUTE=60
API_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
API_RATE_LIMIT_ADMINISTRATION_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost
TRUSTED_PROXIES=
FRONTEND_PASSWORD_RESET_URL=http://localhost/reset-password

ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

HORIZON_NAME=laravel-api
HORIZON_PATH=horizon
HORIZON_PREFIX=laravel_api_horizon:

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
